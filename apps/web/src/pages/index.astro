---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import AsciiMark from "../components/AsciiMark.astro";
import { withBase } from "../lib/url";
import "../styles/global.css";
---

<Layout
  title="eurocloud - one CLI for European clouds"
  description="Create, list, SSH into, and destroy Hetzner and OVHcloud servers from the terminal. JSON output for agents."
  path="/"
>
  <Header current="home" />
  <main id="main">
    <section class="hero">
      <div class="hero-copy">
        <h1>One CLI for European clouds.</h1>
        <p class="lede">
          Create, list, SSH, and destroy Hetzner and OVHcloud servers from the terminal.
        </p>
        <div class="hero-actions">
          <a class="btn" href={withBase("/docs/install")}>Get started</a>
          <a class="btn btn-ghost" href={withBase("/docs/commands")}>Commands</a>
        </div>
      </div>
      <div class="hero-art">
        <AsciiMark />
      </div>
    </section>

    <div class="band band-5">
      <article class="cell">
        <p class="cell-k">$</p>
        <h3>create</h3>
        <p>Spin up a server with provider defaults.</p>
      </article>
      <article class="cell">
        <p class="cell-k">$</p>
        <h3>list</h3>
        <p>Print every instance you can see.</p>
      </article>
      <article class="cell">
        <p class="cell-k">$</p>
        <h3>get</h3>
        <p>Resolve by name or id.</p>
      </article>
      <article class="cell">
        <p class="cell-k">$</p>
        <h3>ssh</h3>
        <p>Open native ssh, or print --json.</p>
      </article>
      <article class="cell">
        <p class="cell-k">$</p>
        <h3>destroy</h3>
        <p>Tear it down when you are done.</p>
      </article>
    </div>

    <div class="band band-2">
      <article class="cell">
        <p class="cell-k">provider</p>
        <h2>Hetzner</h2>
        <p>Bearer token. Default type cpx11 in nbg1. IDs as strings in JSON.</p>
      </article>
      <article class="cell">
        <p class="cell-k">provider</p>
        <h2>OVHcloud</h2>
        <p>Signed keys. Default type b2-7 in GRA11. Switch with --provider ovh.</p>
      </article>
    </div>

    <div class="block-head">
      <h2>+ install</h2>
      <p>Node 18+. Build the workspace package, then run it.</p>
    </div>
    <pre class="install-pre"><code>pnpm install
pnpm cli:build
pnpm cli -- create --name my-app</code></pre>
  </main>
  <Footer />
</Layout>
