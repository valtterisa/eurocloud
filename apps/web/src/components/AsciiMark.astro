---
const mark = [
  "                                                   _                             _ ",
  "     ___     _   _     _ __      ___       ___    | |     ___      _   _      __| |",
  "    / _ \\   | | | |   | '__|    / _ \\     / __|   | |    / _ \\    | | | |    / _` |",
  "   |  __/   | |_| |   | |      | (_) |   | (__    | |   | (_) |   | |_| |   | (_| |",
  "    \\___|    \\__,_|   |_|       \\___/     \\___|   |_|    \\___/     \\__,_|    \\__,_|",
];

const commands = [
  "",
  "  $ eurocloud create --name my-app --provider hetzner",
  "  $ eurocloud list --provider hetzner --json",
  "  $ eurocloud ssh my-app --provider hetzner",
  "  $ eurocloud destroy my-app --provider hetzner",
];

const inner = [...mark, ...commands];
const width = Math.max(...inner.map((line) => line.length));
const bar = `+${"-".repeat(width + 2)}+`;
const art = [bar, ...inner.map((line) => `| ${line.padEnd(width)} |`), bar].join("\n");
---

<pre class="ascii-panel" aria-hidden="true">{art}</pre>
